# Connection string Postgres (Neon / Vercel Postgres). Pakai versi "pooled"
# supaya aman dipakai di serverless function Vercel.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret untuk menandatangani session cookie admin. Generate dengan:
#   openssl rand -base64 32
SESSION_SECRET="ganti-dengan-random-string-panjang"

# Kredensial admin tunggal (v1 belum ada login per-unit, lihat PRD).
ADMIN_USERNAME="admin"
# Hash bcrypt dari password admin. Generate dengan:
#   npx tsx scripts/hash-password.ts "password-anda"
# PENTING: Next.js meng-expand "$VAR" di file .env, jadi setiap karakter $
# di hash bcrypt HARUS di-escape jadi \$ (script hash-password.ts di atas
# sudah otomatis print versi yang sudah di-escape, tinggal copy-paste).
ADMIN_PASSWORD_HASH="\$2a\$10\$replace-with-generated-bcrypt-hash"
